# Copy this file to .env and fill in your own key. .env is gitignored --
# it will never be committed. A real environment variable (set via $env:,
# setx, or your shell) always takes priority over what's in .env, so this
# is just a convenient default, not the only way to configure this.
#
# Two AI providers are supported. Fill in ONE of the two key sections below
# (whichever key is present decides the provider automatically), or set
# AI_PROVIDER explicitly if you ever have both keys set and want to pick.

# --- Option A: Gemini -------------------------------------------------
# Get a key at https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=
# gemini-2.5-flash is a stable, non-preview model -- verified working live.
# Newer preview-tier models (the gemini-3.x line, etc.) are sometimes
# available on the same key but can return HTTP 503 (temporarily
# overloaded); gemini-2.5-pro is a good next step up in capability if
# gemini-2.5-flash's quota is enough for you.
GEMINI_MODEL=gemini-2.5-flash

# --- Option B: GonkaRouter ----------------------------------------------
# Get a key from your GonkaRouter dashboard: https://gonkarouter.io/dashboard
# If this key is set (and AI_PROVIDER isn't forced to "gemini"), it takes
# priority over the Gemini section above.
# deepseek-ai/DeepSeek-V4-Flash-0731 is the non-reasoning model on
# GonkaRouter's catalog -- fast, no <think> overhead, same price as the
# reasoning models (MiniMax-M2.7, GLM-5.3-Flash), verified working live.
GONKAROUTER_API_KEY=
GONKAROUTER_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Uncomment to force a specific provider instead of auto-detecting from
# whichever key above is filled in:
# AI_PROVIDER=gemini
# AI_PROVIDER=gonkarouter
